# Your own modules, profile and deadlines stay private.
# Only the template and the fictional example are tracked.
projects/*
!projects/_template/
!projects/EXAMPLE-*/

# Your study timetable and calendar exports stay private
timetable/
*.ics

# CV, job search and applications stay private too
careers/*
!careers/_template/

# Never commit course materials, even inside tracked folders
*.pdf
*.pptx
*.docx
*.zip
*.apkg

# Local Claude Code settings
.claude/settings.local.json
CLAUDE.local.md

.DS_Store
__pycache__/

# Personal Obsidian vault settings
.obsidian/
