filters:
  and:
    - kind == "module"
    - not:
        - file.inFolder("projects/EXAMPLE-MA30001-linear-algebra")
views:
  - type: table
    name: All modules
    order:
      - file.folder
      - code
      - title
      - semester
      - credits
      - assessment
      - leader
      - moodle
    sort:
      - property: code
        direction: ASC
  - type: cards
    name: Cards
    order:
      - code
      - title
      - semester
      - credits
      - assessment
